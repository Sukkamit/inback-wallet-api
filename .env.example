PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=order_tracking_db
DB_POOL_MAX=20
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_tracking_db

# Business Rules & SLA Configs
PAYMENT_EXPIRY_MINUTES=15
QUEUE_SLA_MINUTES=10
DEFAULT_LEASE_SECONDS=60
MAX_BOT_RETRIES=3

# Security & Secrets
BANK_WEBHOOK_SECRET=bank_webhook_secret_key
